# MDIN Backend Environment Variables
# Copy this file to `.env` in backend/ or root directory.

PROJECT_NAME="Medical-Dental Interoperability Node (MDIN)"
VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# --- Live CareStack account (OUTBOUND) ---
# Leave USE_LIVE_CARESTACK=false to run against the bundled simulator (default, and
# what the demo uses). To target a real CareStack account, set it to true and supply
# all four values below from your CareStack partner account. These are real secrets:
# keep them in .env only, never commit them.
USE_LIVE_CARESTACK=false
CARESTACK_BASE_URL=
CARESTACK_VENDOR_KEY=
CARESTACK_ACCOUNT_KEY=
CARESTACK_ACCOUNT_ID=

# --- Bundled CareStack simulator (INBOUND) ---
# Demo credentials the in-process simulator accepts. Not secrets - they gate
# synthetic data only. Override just to prove the auth path rejects bad keys.
SIMULATOR_VENDOR_KEY=demo-vendor-key
SIMULATOR_ACCOUNT_KEY=demo-account-key
SIMULATOR_ACCOUNT_ID=demo-account-001

# FHIR R4 Healthcare Server
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4

# CDS Hooks
CDS_DISCOVERY_PATH=/cds-services

# --- MAO Assistant (one master agent + parallel specialists) ---
# Any ONE key is enough. The master (tool-calling) provider is the first configured of
# gemini -> groq -> nvidia; every other configured provider becomes a parallel specialist
# for consult_specialists. Real secrets: keep them in .env only.
# Patient context is sent to these providers when the assistant runs: use synthetic data only.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Groq: https://console.groq.com/keys (also powers Whisper voice input)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA NIM: https://build.nvidia.com ("Get API Key", nvapi-...)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Force the master provider: gemini | groq | nvidia (empty = first configured)
ASSISTANT_MASTER_PROVIDER=

# --- Voice input (speech to text) ---
# auto = NVIDIA when NVIDIA_STT_URL is set, else Groq Whisper. NVIDIA's hosted Nemotron ASR is
# gRPC-only (Riva), so the NVIDIA route needs a self-hosted Speech NIM base URL, e.g.
# http://localhost:9000. With no speech provider the UI falls back to the browser's Web Speech API.
STT_PROVIDER=auto
GROQ_STT_MODEL=whisper-large-v3-turbo
NVIDIA_STT_MODEL=nvidia/nemotron-asr-streaming
NVIDIA_STT_URL=

# --- Scanned-PDF OCR (previous records uploaded as PDF) ---
# PDFs with a text layer are read locally and need nothing. Scans need OCR:
# auto = NVIDIA Nemotron Parse when NVIDIA_API_KEY is set, otherwise Gemini.
DOCUMENT_OCR_PROVIDER=auto
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse
