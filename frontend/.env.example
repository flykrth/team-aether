# Frontend Environment Variables
# Backend the browser calls directly. Must match the port the backend really runs on
# (backend/.env PORT, default 8000; use http://localhost:8080 if you start uvicorn on 8080).
VITE_API_BASE_URL=http://localhost:8000
# Leave VITE_API_BASE_URL empty to go through the Vite dev proxy instead; the proxy then forwards
# /api, /cds-services and /health to this target (default http://localhost:8000).
VITE_PROXY_TARGET=
