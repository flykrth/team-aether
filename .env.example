# ==============================================================================
# MDIN Environment Configuration Template
# Copy this file to .env and configure for local development or production.
# ==============================================================================

PROJECT_NAME="Medical-Dental Interoperability Node (MDIN)"
VERSION="0.1.0"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# HL7 FHIR Public Test Server Integration
# Directory: https://confluence.hl7.org/spaces/FHIR/pages/35718859/Public+Test+Servers
# Primary Option: HAPI FHIR Reference Server
FHIR_SERVER_URL="https://hapi.fhir.org/baseR4"
# Alternative Option: NLM HAPI FHIR Server
# FHIR_SERVER_URL="https://lforms-fhir.nlm.nih.gov/baseR4"
# Alternative Option: Firely Server
# FHIR_SERVER_URL="https://server.fire.ly/r4"

FHIR_FALLBACK_SERVER_URL="https://lforms-fhir.nlm.nih.gov/baseR4"
FHIR_TIMEOUT_SECONDS=8.0
FHIR_USE_CACHE_FALLBACK=True

# CDS Hooks Configuration
CDS_DISCOVERY_PATH="/cds-services"

# CareStack PMS Simulator Demo Credentials (Inbound)
SIMULATOR_VENDOR_KEY="demo-vendor-key"
SIMULATOR_ACCOUNT_KEY="demo-account-key"
SIMULATOR_ACCOUNT_ID="demo-account-001"

# CareStack Live Account Integration (Outbound - Real Credentials)
USE_LIVE_CARESTACK=False
CARESTACK_BASE_URL=""
CARESTACK_VENDOR_KEY=""
CARESTACK_ACCOUNT_KEY=""
CARESTACK_ACCOUNT_ID=""
